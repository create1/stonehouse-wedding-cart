# Copy to .env.local and fill in. Read only by the local Vite server, never sent to the browser.
DECART_API_KEY=your-decart-api-key

# Optional overrides
# DECART_MODEL=lucy-2.6
# DECART_SPEED=fast            # 2x price, lower latency
# DECART_RESOLUTION=1080p      # default is the model's 720p
# DECART_SELF_ANCHOR=true      # default false; the kiosk sees different people walk in and out
# DECART_ENHANCE=true          # default false; Lucy's prompt rewriting sometimes replaced the person's identity
# DECART_LIVE_REFERENCE=true   # default false; sends a live camera frame as reference image (keeps face, but weakens costumes)
